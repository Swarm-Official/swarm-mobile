<?xml version="1.0" encoding="UTF-8"?>
<!--
    SWARM Wallet launch screen.

    Design system: warm black #0A0908 with the hive-bee mark centred and
    nothing else. No wordmark, because a launch screen cannot load the
    brand typeface (Sora) and a substituted font would misrepresent it.

    The mark comes from the LaunchMark image set, whose PNGs are rendered
    in CI from ios/branding/swarm-appicon.svg by
    ios/scripts/generate-ios-art.sh. The image is a warm-black square, so
    it disappears into this view's background and only the bee shows.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21507" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="Swm-Bx-mrk">
                                <rect key="frame" x="107.5" y="253.5" width="160" height="160"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="160" id="Swm-Bx-wid"/>
                                    <constraint firstAttribute="height" constant="160" id="Swm-Bx-hei"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                        <color key="backgroundColor" red="0.039215686274509803" green="0.035294117647058823" blue="0.031372549019607843" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="Swm-Bx-mrk" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="Swm-Bx-ctx"/>
                            <constraint firstItem="Swm-Bx-mrk" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" id="Swm-Bx-cty"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52.173913043478265" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchMark" width="160" height="160"/>
    </resources>
</document>
