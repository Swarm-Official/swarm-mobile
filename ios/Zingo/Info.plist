<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background task identifiers are internal, never shown to anyone,
	     and are matched literally by ios/AppDelegate.swift. Left exactly
	     as upstream on purpose: renaming them changes behaviour and
	     brands nothing. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.transistorsoft.fetch</string>
		<string>Zingo_Refresh_Task_ID</string>
		<string>Zingo_Processing_Task_ID</string>
		<string>Zingo_Processing_Scheduler_Task_ID</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(BUNDLE_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- No CFBundleURLTypes and no LSApplicationQueriesSchemes.
	     Upstream claims the public `zcash:` URL scheme; SWARM is a
	     separate test network and must not intercept Zcash payment links
	     on anyone's phone, so the claim is removed rather than renamed.
	     Nothing in the app depends on it: the `zcash:` handling in the
	     shared JavaScript parses strings that are pasted or scanned, not
	     links routed by iOS. -->
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSMinimumSystemVersion</key>
	<string>13.0.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Provenance, kept deliberately. SWARM Wallet is a fork and says so;
	     the MIT notices this app inherits stay in place. -->
	<key>NSHumanReadableCopyright</key>
	<string>SWARM Wallet. Based on Zingo Mobile by ZingoLabs (MIT licence), which builds on zingolib (MIT). SWM are test coins on a private test network and have no value.</string>
	<key>NSCameraUsageDescription</key>
	<string>SWARM Wallet uses the camera only to scan a SWARM address or payment QR code. Nothing is photographed, stored or sent.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>SWARM Wallet uses Face ID or Touch ID to unlock your wallet on this device. Your wallet never leaves the phone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SWARM Wallet does not use location. It never asks for your position and records none.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SWARM Wallet saves a receive-address QR code to your photos when you ask it to. It reads nothing else from your library.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<!-- The three SWARM typefaces, bundled in the app so nothing is
	     fetched at runtime (a font request would leak that the wallet was
	     opened, and by whom, before it had done anything else).

	     react-native.config.js links assets/fonts for Android only
	     (`project: { android: {} }`), and this app does no runtime font
	     loading, so without these two pieces — the folder reference in
	     Zingo.xcodeproj and this list — every `fontFamily: 'Sora-…'` in
	     app/theme/typography.ts would silently fall back to the system
	     face and the design system would simply not appear on iOS.

	     The paths carry the `fonts/` prefix because the Xcode project
	     copies assets/fonts in as a folder reference, which keeps the
	     directory in the bundle and picks up any face added later
	     without another project edit. -->
	<key>UIAppFonts</key>
	<array>
		<string>fonts/Sora-Regular.ttf</string>
		<string>fonts/Sora-SemiBold.ttf</string>
		<string>fonts/Sora-Bold.ttf</string>
		<string>fonts/Manrope-Regular.ttf</string>
		<string>fonts/Manrope-Medium.ttf</string>
		<string>fonts/Manrope-SemiBold.ttf</string>
		<string>fonts/JetBrainsMono-Regular.ttf</string>
		<string>fonts/JetBrainsMono-Medium.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<!-- Upstream reads "LaunchScreen.storyboar": a typo, so iOS finds no
	     launch storyboard and shows a blank one. Corrected here so the
	     SWARM launch screen in LaunchScreen.storyboard is actually used. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
